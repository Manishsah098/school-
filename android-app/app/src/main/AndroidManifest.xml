<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.school.portal.android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolPortalAndroid"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".ui.RoleSelectionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".ui.LoginActivity" />
        <activity android:name=".ui.AdminDashboardActivity" />
        <activity android:name=".ui.TeacherDashboardActivity" />
        <activity android:name=".ui.StudentDashboardActivity" />
        <activity android:name=".ui.NoticesActivity" />
        <activity android:name=".ui.ManageUsersActivity" />
        <activity android:name=".ui.NotificationsActivity" />
    </application>

</manifest>
